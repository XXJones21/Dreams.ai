# Dreams.ai frontend environment
# Copy to `.env` (or `.env.local`) and adjust.

# Base URL of the Dreams.ai FastAPI backend. The WebSocket URL is derived from
# this automatically (http -> ws, https -> wss).
#   Local dev (backend on this machine):
VITE_API_BASE_URL=http://localhost:8000
#   Phone over an HTTPS tunnel — point at the TUNNELED backend origin, e.g.:
# VITE_API_BASE_URL=https://your-backend-tunnel.trycloudflare.com

# Supabase (existing) — used for auth on the protected routes.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
