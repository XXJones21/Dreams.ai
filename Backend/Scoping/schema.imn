### Example: Categorized .imn Schema

```json
{
  "pre_production": {
    "dream_name": "The Princess Rescue",
    "user_prompt": "rescue a princess from a castle",
    "story_prompt": "You are a brave knight navigating through an ancient Castle Drakon to rescue Princess Aurelia from the clutches of the fearsome dragon, Ignis.",
    "dream_tone": "Epic Fantasy",
    "actionable_goal": "Reach the princess and defeat the dragon.",
    "characters": ["Princess Aurelia", "Ignis"],
    "locations": ["Castle Drakon", "Dragon's Lair"],
    "plot_points": ["Navigate the castle's traps", "Defeat the enchanted creatures", "Confront Ignis"],
    "created_by": "User",
    "created_at": "2024-07-01T12:00:00Z"
  },
  "in_production": [
    {
      "scene_id": 1,
      "frame_image": "frames/scene1_0005.png",
      "timestamp": "00:05",
      "scene_context": "Sir Reginald stands in a dim hallway. There is a door on the left and a staircase ahead.",
      "user_action": "enter the door",
      "tap_location": { "x": 120, "y": 340 },
      "object_tapped": "left door"
    }
  ],
  "post_production": {
    "final_outcome": "Sir Reginald rescued Princess Aurelia and defeated Ignis.",
    "user_feedback": "Loved the branching choices!",
    "exported_at": "2024-07-01T12:30:00Z"
  }
}
